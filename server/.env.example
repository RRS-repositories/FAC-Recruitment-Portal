# FAC recruitment portal — API. Copy to server/.env and fill in.
# Never commit the filled-in file; this example carries names only.

NODE_ENV=development
PORT=5000

# --- Database ------------------------------------------------------------
# The portal has its own database. It does NOT connect to the CRM.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=fac_recruitment
PGUSER=fac_recruit_app
PGPASSWORD=
PGSSL=false

# --- Scheduling ----------------------------------------------------------
# Availability rules are stored and evaluated in this zone, then converted to
# each candidate's timezone for display. UK-anchored: 09:00-17:00 here means
# IST 13:30-21:30 and SAST 10:00-18:00 in summer.
INTERVIEW_TIMEZONE=Europe/London

# --- Application intake ---------------------------------------------------
# Salt for hashing candidate IPs. Generate once: openssl rand -hex 32
IP_HASH_SALT=

# Where CVs are written. On the production box this belongs on /data — the
# separate 1.7TB disk where files live — NOT on the root filesystem, and NOT
# under /data/s3-root, which rclone serves publicly at files.rowanroseclaims.co.uk.
#   production: /data/fac-recruitment/cvs
CV_STORAGE_DIR=./var/cvs

APPLY_RATE_WINDOW_MS=3600000
APPLY_RATE_MAX=10

# --- Booking --------------------------------------------------------------
BOOK_RATE_WINDOW_MS=900000
BOOK_RATE_MAX=60

# --- Admin (interim: replaced by Cloudflare Access later) -----------------
# Per-manager credentials, so the audit trail records who decided.
# Generate a hash:  node scripts/hash-password.js 'their password'
# Format: username:email:hash,username:email:hash
ADMIN_USERS=

# Signs the short-lived admin tokens. openssl rand -hex 32
ADMIN_TOKEN_SECRET=

ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_MAX=10

# --- Email (stage 5) ------------------------------------------------------
# Leave SMTP_HOST unset and every email is composed and written to
# MAIL_FILE_DIR instead of being sent. Nothing is silently discarded, and the
# dashboard says plainly that mail is going to disk. Set these four values and
# it starts delivering for real — no code change.
#
# Office 365: host smtp.office365.com, port 587, SMTP_SECURE=false (587 is
# STARTTLS, which is an upgrade rather than "insecure"; only 465 wants true).
# Check SMTP AUTH is enabled for the mailbox first — Microsoft disables it by
# default, and no password will work until it is switched on.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Where mail goes when SMTP_HOST is unset. Under var/, which is gitignored.
MAIL_FILE_DIR=./var/mail

# Who the mail comes from, and where replies land.
MAIL_FROM=recruitment@fastactionclaims.co.uk
MAIL_FROM_NAME=Fast Action Claims
MAIL_REPLY_TO=

# How often the queue is drained. Chosen by the tightest deadline it has —
# the ten-minute interview reminder.
OUTBOX_INTERVAL_MS=30000

# Where booking links in emails point.
#
# Production: https://fastactionclaims.co.uk/recruitment
#
# The /recruitment part matters. Booking answers on both /book/:token and
# /recruitment/book/:token, but only the second sits under the path the
# candidate-facing rule serves — so a link composed without it would reach
# nothing. The admin screens have their own rule and stay at /admin.
PUBLIC_BASE_URL=http://localhost:5173

# --- Spam protection (spec §4) --------------------------------------------
# Cloudflare Turnstile. Leave TURNSTILE_SECRET_KEY unset and no check is made
# at all -- the form still works, and the Settings screen says plainly that it
# is unprotected rather than letting a widget imply otherwise.
#
# Two values, from the Turnstile dashboard, and they are NOT interchangeable:
#   TURNSTILE_SECRET_KEY  here, secret. This is the one that enforces anything.
#   VITE_TURNSTILE_SITE_KEY  in client/.env, public, baked into the build.
#
# A site key without a secret is a widget nobody checks. Set both.
# Cloudflare's own testing keys are documented and safe to use in development:
#   always passes: 1x0000000000000000000000000000000AA (site 1x00000000000000000000AA)
#   always blocks: 2x0000000000000000000000000000000AA (site 2x00000000000000000000AB)
TURNSTILE_SECRET_KEY=

# --- Privacy (spec §12) ---------------------------------------------------
# The application form tells candidates their data is processed in the UK and
# links to the notice at /recruitment/privacy, which this app serves. Set
# VITE_PRIVACY_URL in the CLIENT environment only to point that link somewhere
# else -- a firm-wide policy page, say. Left unset, the built-in notice is used.
#
# That page reads the CV retention period from the API rather than hardcoding
# it, so changing retention on the Settings screen changes what candidates are
# told. Nothing to configure here.

# --- AI review (Ollama) ---------------------------------------------------
# RECRUIT_-prefixed on purpose. The CRM this module mounts inside already uses
# OLLAMA_BASE_URL for its own local Ollama, and dotenv takes the LAST
# definition of a key -- so a plain OLLAMA_BASE_URL here would repoint the
# CRM's AI worker at a hosted service without a word.
# Two questions asked of a model per application: how well the CV and answers
# fit the role, and whether the writing reads as AI-assisted.
#
# THIS SENDS CANDIDATES' CVs AND WRITTEN ANSWERS TO A THIRD PARTY. It takes two
# deliberate acts to switch on -- a key here AND the recruitment_ai_review flag
# on the Settings screen -- because neither an accidental flag nor a stray key
# should start processing personal data. If the model is hosted rather than
# self-hosted, the privacy notice at /recruitment/privacy must say so before
# real candidate data is sent.
#
# Unset, nothing is reviewed and the API says so, exactly as it does for mail
# and captcha. Applications are unaffected: the review is a background job and
# never sits on the submission path.
RECRUIT_OLLAMA_API_KEY=
RECRUIT_OLLAMA_BASE_URL=https://ollama.com
# Must match a tag the account actually serves -- check with:
#   curl -H "Authorization: Bearer $RECRUIT_OLLAMA_API_KEY" https://ollama.com/api/tags
# A tag that does not exist HANGS rather than 404s, so it looks like a network
# fault. 'gemma4:31b-cloud' is not a tag; 'gemma4:31b' is.
RECRUIT_OLLAMA_MODEL=gemma4:31b
RECRUIT_OLLAMA_TIMEOUT_MS=90000

# How much of a CV is read. Longer prompts cost more and rarely say more.
CV_TEXT_MAX_CHARS=20000

# Retry budget and pace for the review worker.
LLM_REVIEW_MAX_ATTEMPTS=4
LLM_REVIEW_INTERVAL_MS=60000
LLM_REVIEW_BATCH=3

# --- Automatic Google Meet links ------------------------------------------
# A candidate books, and the confirmation carries a working Meet link with
# nobody touching anything.
#
# RECRUIT_-prefixed like the Ollama keys, and for the same reason: this module
# shares an .env with the CRM, which has Google credentials of its own, and
# dotenv takes the LAST definition of a key.
#
# Get these by running, once, on a machine with a browser:
#   node scripts/google-consent.js <client-id> <client-secret>
# The client id and secret come from console.cloud.google.com -> Credentials
# -> OAuth client ID -> Desktop app.
#
# PUBLISH THE OAUTH CONSENT SCREEN FIRST. Left in "Testing", Google expires the
# refresh token after SEVEN DAYS: everything works, then stops the following
# week, and the first symptom is candidates being told a link will follow.
#
# Then prove the account can actually mint a link before trusting it:
#   node scripts/verify-meet.js <client-id> <client-secret> <refresh-token>
#
# Unset, no link is created, the manual paste on the dashboard still works, and
# the emails say "We will email you the video link" rather than promising one.
# Nothing happens until flags.recruitment_auto_meet is also true.
RECRUIT_GOOGLE_CLIENT_ID=
RECRUIT_GOOGLE_CLIENT_SECRET=
RECRUIT_GOOGLE_REFRESH_TOKEN=
RECRUIT_GOOGLE_TIMEOUT_MS=20000

# Put the candidate on the invitation. Default true: without it an external
# guest has to knock and be admitted, which is a poor first impression if the
# interviewer is a minute late. Google's own emails are suppressed either way.
RECRUIT_GOOGLE_INVITE_CANDIDATE=true

# The sweep that fills in links the booking path failed to create.
MEET_LINK_MAX_ATTEMPTS=5
MEET_LINK_INTERVAL_MS=120000
MEET_LINK_BATCH=5
