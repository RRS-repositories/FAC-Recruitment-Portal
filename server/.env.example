# Atlas intake service — copy to server/.env and fill in.
# Never commit the filled-in file. Placeholder names only in this example.

# --- Atlas PostgreSQL cluster -------------------------------------------
# The separate cluster created with:
#   sudo pg_createcluster 17 atlas --port 5434 --start
# Port 5432 is the CRM cluster; the service refuses to start if pointed there.
ATLAS_DB_HOST=127.0.0.1
ATLAS_DB_PORT=5434
ATLAS_DB_NAME=atlas_recruitment
ATLAS_DB_USER=atlas_app
ATLAS_DB_PASSWORD=
ATLAS_DB_SSL=false
ATLAS_DB_POOL_MAX=5

# --- Service -------------------------------------------------------------
ATLAS_PORT=5010

# Salt for hashing client IPs. Generate once, never rotate casually (rotating
# makes existing hashes uncomparable):  openssl rand -hex 32
ATLAS_IP_HASH_SALT=

# --- Abuse limits --------------------------------------------------------
ENQUIRY_RATE_WINDOW_MS=3600000
ENQUIRY_RATE_MAX=5

# --- Notifications -------------------------------------------------------
# OFF by default. Enquiries are captured regardless; unsent rows wait in the
# outbox until this is switched on, so nothing is lost while it is false.
ENQUIRY_NOTIFY_ENABLED=false
ENQUIRY_NOTIFY_TO=
ENQUIRY_NOTIFY_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
