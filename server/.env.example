# FAC recruitment portal — API. Copy to server/.env and fill in.
# Never commit the filled-in file; this example carries names only.

NODE_ENV=development
PORT=5020

# --- Database ------------------------------------------------------------
# The portal has its own database. It does NOT connect to the CRM.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=fac_recruitment
PGUSER=fac_recruit_app
PGPASSWORD=
PGSSL=false

# --- Scheduling ----------------------------------------------------------
# Availability rules are stored and evaluated in this zone, then converted to
# each candidate's timezone for display. UK-anchored: 09:00-17:00 here means
# IST 13:30-21:30 and SAST 10:00-18:00 in summer.
INTERVIEW_TIMEZONE=Europe/London
